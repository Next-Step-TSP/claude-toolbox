# Copy this file to ".env" and fill in what you need.

# --- Workspace mounts ---
# Host folders bind-mounted into the container at /workspace/_Claude and
# /workspace/_pallas (see docker-compose.yml). Set these to paths on your PC.
# This PC's current values (example only):
#   WORKSPACE_CLAUDE=C:\Users\MarkPrescott\NSTSP\SP_Operations - Files\_Claude
#   WORKSPACE_PALLAS=C:\Users\MarkPrescott\NSTSP\SP_Operations - Files\_pallas
WORKSPACE_CLAUDE=
WORKSPACE_PALLAS=

# --- Claude auth (optional) ---
# Use an API key instead of interactive login. Leave blank to log in interactively.
ANTHROPIC_API_KEY=

# --- Tailscale (only needed for the remote/phone-access box) ---
# Generate an auth key at: https://login.tailscale.com/admin/settings/keys
# Required only on the FIRST launch of claude-remote; afterwards the persisted
# state volume re-authenticates without it. Use a non-ephemeral key so the node
# survives restarts (or an ephemeral key if you want it to disappear when down).
TS_AUTHKEY=

# Tailnet hostname the box appears as (you SSH to ssh node@<this>).
TS_HOSTNAME=claude-code

# Extra args passed to `tailscale up`, e.g. --advertise-tags=tag:ci  (usually blank).
TS_EXTRA_ARGS=

# --- Multiple Claude accounts ---
# Space-separated profile names. Each one becomes a `claude-<name>` command
# inside the container with its own isolated login/config (~/.claude-<name>),
# so several accounts can run side-by-side. Set up automatically on every
# container start (see entrypoint.sh), so it survives a claude-home reset.
CLAUDE_PROFILES=nstsp extra
