# Copy this file to ".env" and fill in what you need.

# --- Workspace mounts ---
# Host folders bind-mounted into the container at /workspace/_Claude and
# /workspace/_pallas (see docker-compose.yml). Set these to paths on your PC.
# This PC's current values (example only):
#   WORKSPACE_CLAUDE=C:\Users\MarkPrescott\NSTSP\SP_Operations - Files\_Claude
#   WORKSPACE_PALLAS=C:\Users\MarkPrescott\NSTSP\SP_Operations - Files\_pallas
WORKSPACE_CLAUDE=
WORKSPACE_PALLAS=

# --- Claude auth (optional) ---
# Use an API key instead of interactive login. Leave blank to log in interactively.
ANTHROPIC_API_KEY=

# Self-update Claude Code (npm @latest) on every container start. Default 1 (on).
# Set to 0 to pin to the currently installed version (e.g. offline / air-gapped).
UPDATE_CLAUDE_ON_START=1

# --- Tailscale (only needed for the remote/phone-access box) ---
# Generate an auth key at: https://login.tailscale.com/admin/settings/keys
# Required only on the FIRST launch of claude-remote; afterwards the persisted
# state volume re-authenticates without it. Use a non-ephemeral key so the node
# survives restarts (or an ephemeral key if you want it to disappear when down).
TS_AUTHKEY=

# Tailnet hostname the box appears as (you SSH to ssh node@<this>).
TS_HOSTNAME=claude-code

# Extra args passed to `tailscale up`, e.g. --advertise-tags=tag:ci  (usually blank).
TS_EXTRA_ARGS=

# Userspace networking for tailscaled. Default 0 (kernel TUN, needs NET_ADMIN +
# /dev/net/tun). Set to 1 to run without those caps (e.g. restricted hosts).
TS_USERSPACE=0

# --- ttyd web terminal (optional) ---
# Serves an attach-or-create tmux session in the browser as the node user.
# NO built-in auth and writable — expose ONLY on the tailnet/LAN. Default off.
TTYD_ENABLE=0
TTYD_PORT=7681

# --- User / group / timezone (Unraid-style; honoured only when the container
# runs as root, i.e. the remote/Unraid service) ---
# Remap the node user so bind-mounted files match host ownership. Unraid uses
# 99/100. Leave blank to keep the image default (uid/gid 1000).
PUID=
PGID=
# IANA timezone, e.g. America/Edmonton. Blank = container default (UTC).
TZ=
# Optional file-creation umask, e.g. 022. Blank = default.
UMASK=

# --- Multiple Claude accounts ---
# Space-separated profile names. Each one becomes a `claude-<name>` command
# inside the container with its own isolated login/config (~/.claude-<name>),
# so several accounts can run side-by-side. Set up automatically on every
# container start (see entrypoint.sh), so it survives a claude-home reset.
CLAUDE_PROFILES=nstsp extra

# --- Claude Code plugin bootstrap (optional) ---
# Space-separated marketplace sources (GitHub slugs or URLs) added to every
# profile at startup, and space-separated plugins installed from them
# (plugin@marketplace). Cloned at runtime with the container's own git/gh
# credentials — nothing private is baked into the image. Bootstrap is skipped
# silently if no credentials are available. Leave blank to disable.
#   CLAUDE_MARKETPLACES=Next-Step-TSP/nstsp-claude-marketplace
#   CLAUDE_PLUGINS=core-toolkit@nstsp
CLAUDE_MARKETPLACES=
CLAUDE_PLUGINS=
